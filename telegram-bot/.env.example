# Copy to telegram-bot/.env and fill in. telegram-bot/.env itself is gitignored.
# Same TELEGRAM_BOT_TOKEN as backend/.env — both services need the same bot identity.

SERVER_PORT=8081

DATABASE_URL=jdbc:postgresql://localhost:5432/academix
DATABASE_APP_USERNAME=academix_app
DATABASE_APP_PASSWORD=academix_app_local_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=academix_notify_bot
