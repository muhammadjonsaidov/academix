# Client-exposed vars must use the NEXT_PUBLIC_ prefix — anything without it stays server-only.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_SENTRY_DSN=

# Server-only (read by proxy.ts, never sent to the browser). MUST be byte-for-byte identical
# to the backend's JWT_SECRET — proxy.ts and JwtService.java both derive their HMAC key from
# the raw secret bytes, not a hash of it. If these two values differ, every request gets
# redirected to /login even with a valid session (signature verification silently fails).
JWT_SECRET=local-dev-only-placeholder-not-for-production-use
