# Secrets — never commit real .env files (matches secrets-guard hook assumptions)
.env
.env.local
.env.production
.env.development
.env.test
backend/.env
frontend/.env.local
!.env.example
!backend/.env.example
!frontend/.env.local.example

# Backend (Gradle)
backend/.gradle/
backend/build/
backend/out/
!backend/gradle/wrapper/gradle-wrapper.jar

# Telegram bot (Gradle)
telegram-bot/.gradle/
telegram-bot/build/
telegram-bot/out/
!telegram-bot/gradle/wrapper/gradle-wrapper.jar

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.turbo/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local infra state
infra/postgres-data/
infra/backups/

# Claude Code personal overrides (project-scoped, not team-shared)
.claude/settings.local.json

# NOTE: .github/workflows/ used to be ignored here ("kept locally, skipped on GitHub for now").
# It is tracked again as of the CI addition — a workflow that is never committed never runs, and
# until now literally nothing verified a commit automatically (both PostToolUse gates were also
# silently dead, see .claude/hooks). Re-ignore this only if you deliberately want no CI.

# Playwright run artifacts (reports, traces, .last-run.json). Written under frontend/ normally,
# but at the repo root too if playwright is ever invoked from the wrong directory.
playwright-report/
test-results/
/blob-report/
/playwright/.cache/

# Internal/spec docs — kept locally, not on GitHub (private→public repo prep)
/CLAUDE.md
/ROADMAP.md
/academix_tz.md
/academix_backend_tdd.md
/academix_frontend_tdd.md
