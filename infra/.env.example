[TEMPLATE]
# Copy to infra/.env and fill in real secrets — infra/.env itself is gitignored.
# Local defaults are only for disposable development. Demo users are never started
# unless `docker compose --profile demo up` is explicitly used.

# --- MUST be set for anything beyond localhost dev -------------------------
# Byte-for-byte identical across backend + frontend (both derive their HMAC key
# from the raw bytes, not a hash). Generate: openssl rand -hex 32
JWT_SECRET=local-dev-only-placeholder-not-for-production-use

# --- Optional — app degrades gracefully without these ----------------------
# Any OpenAI-compatible provider (AI grading / chat / psychology / generation).
# DeepSeek example: https://api.deepseek.com + deepseek-v4-flash.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_TEXT=deepseek-v4-flash
# Leave blank when the provider has no vision model; OCR remains Google Vision.
AI_MODEL_VISION=

# Google Cloud Vision (OCR + handwriting biometrics).
GOOGLE_VISION_API_KEY=

# Gmail SMTP (password-reset email). GMAIL_APP_PASSWORD = 16-char App Password.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Telegram — token only needed for the bot to actually send/deliver.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=academix_notify_bot

# --- Optional overrides of the local-dev defaults --------------------------
DATABASE_USERNAME=academix
DATABASE_PASSWORD=academix
DATABASE_APP_USERNAME=academix_app
DATABASE_APP_PASSWORD=academix_app_local_dev_only

REDIS_PASSWORD=

RABBITMQ_USERNAME=academix
RABBITMQ_PASSWORD=academix_local_dev

SEAWEEDFS_ACCESS_KEY=local-dev-access-key
SEAWEEDFS_SECRET_KEY=local-dev-secret-key
SEAWEEDFS_BUCKET=homeworks

# Browser-visible URLs (baked into the frontend build).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=academix_notify_bot
NEXT_PUBLIC_SENTRY_DSN=
