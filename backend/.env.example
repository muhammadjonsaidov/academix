# Copy to backend/.env and fill in the blanks. backend/.env itself is gitignored (see root
# .gitignore) — never commit it. See CLAUDE.md "Commands" for what each var does.

SERVER_PORT=8080

# Postgres superuser — Flyway migrations only (CREATE EXTENSION needs it). Matches
# infra/docker-compose.yml's dev defaults; change both places together if you change this.
DATABASE_URL=jdbc:postgresql://localhost:5432/academix
DATABASE_USERNAME=academix
DATABASE_PASSWORD=academix

# Restricted, NOSUPERUSER/NOBYPASSRLS role — the app's actual runtime datasource (RLS is
# silently inert for a superuser connection, see CLAUDE.md "Reality checks"). Created by
# infra/postgres-init/01-app-role.sh.
DATABASE_APP_USERNAME=academix_app
DATABASE_APP_PASSWORD=academix_app_local_dev_only

# Must be byte-for-byte identical to frontend/.env.local's JWT_SECRET — both derive their HMAC
# key from the raw secret bytes, not a hash (see CLAUDE.md "Reality checks"). Generate a real
# random value for anything beyond local dev; the placeholder below only exists so the app boots.
JWT_SECRET=local-dev-only-placeholder-not-for-production-use

FRONTEND_URL=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- Real secrets you need to supply — the app boots and degrades gracefully without them
# (AI_SKIPPED / no OCR / no Telegram delivery), see CLAUDE.md's graceful-degradation notes, but
# nothing AI-related or Telegram-related actually works until these are set. ---

# Alibaba Qwen via DashScope's OpenAI-compatible endpoint.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_TEXT=qwen3.7-max
QWEN_MODEL_VISION=qwen3.7-plus

# Google Cloud Vision — OCR + bounding boxes (handwriting biometrics needs this specifically).
GOOGLE_VISION_API_KEY=

# Telegram bot username only — the bot itself (token, actual sending/receiving) lives in the
# standalone telegram-bot/ service (see telegram-bot/.env.example), not here. This backend only
# needs the username to build deep-link URLs (https://t.me/{username}?start=...).
TELEGRAM_BOT_USERNAME=academix_notify_bot

# SeaweedFS S3-compatible storage — must match infra/seaweedfs-config/s3-config.json's identity
# (plain seaweedfs -s3 with no -s3.config rejects every signed request outright, see CLAUDE.md).
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=local-dev-access-key
SEAWEEDFS_SECRET_KEY=local-dev-secret-key
