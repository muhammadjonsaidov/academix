# Copy to backend/.env and fill in the blanks. backend/.env itself is gitignored (see root
# .gitignore) — never commit it. See CLAUDE.md "Commands" for what each var does.

SERVER_PORT=8080

# Postgres superuser — Flyway migrations only (CREATE EXTENSION needs it). Matches
# infra/docker-compose.yml's dev defaults; change both places together if you change this.
DATABASE_URL=jdbc:postgresql://localhost:5432/academix
DATABASE_USERNAME=academix
DATABASE_PASSWORD=academix

# Restricted, NOSUPERUSER/NOBYPASSRLS role — the app's actual runtime datasource (RLS is
# silently inert for a superuser connection, see CLAUDE.md "Reality checks"). Created by
# infra/postgres-init/01-app-role.sh.
DATABASE_APP_USERNAME=academix_app
DATABASE_APP_PASSWORD=academix_app_local_dev_only

# Must be byte-for-byte identical to frontend/.env.local's JWT_SECRET — both derive their HMAC
# key from the raw secret bytes, not a hash (see CLAUDE.md "Reality checks"). Generate a real
# random value for anything beyond local dev; the placeholder below only exists so the app boots.
JWT_SECRET=local-dev-only-placeholder-not-for-production-use

FRONTEND_URL=http://localhost:3000

# Cookie Domain for academix_auth/academix_refresh. Empty = host-only (correct for localhost).
# Deploys with frontend+backend on sibling subdomains set the parent domain, e.g. .academixai.uz
# — see AuthController.
COOKIE_DOMAIN=

# Hikari pool cap — default 10 for local dev; constrained deploys may use 5.
DB_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379
# Empty = no AUTH (local dev). Networked deploys must set it (see application.yml).
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# guest/guest only works over loopback (local dev). Networked deploys need a real broker user.
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Real secrets you need to supply — the app boots and degrades gracefully without them
# (AI_SKIPPED / no OCR / no Telegram delivery), see CLAUDE.md's graceful-degradation notes, but
# nothing AI-related or Telegram-related actually works until these are set. ---

# DeepSeek is used for chat, grading and lesson-plan generation.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/
AI_MODEL_TEXT=deepseek-flash
# Leave blank when the provider has no vision model; OCR remains Google Vision.
AI_MODEL_VISION=
# Qwen is used only for syllabus retrieval embeddings. The database vector column is 1024D.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL_EMBEDDING=qwen3.7-text-embedding
AI_EMBEDDING_DIMENSIONS=1024

# Google Cloud Vision — OCR + bounding boxes (handwriting biometrics needs this specifically).
GOOGLE_VISION_API_KEY=

# Gmail SMTP — ADMIN/TEACHER/PARENT/PSYCHOLOGIST password-reset email (academix_tz.md §2.1).
# GMAIL_APP_PASSWORD is a 16-char Google App Password (Google Account > Security > 2-Step
# Verification > App Passwords), NOT the real account password — Gmail rejects plain account
# passwords for SMTP auth. Empty = forgot-password still returns success (anti-enumeration) but
# no email actually sends, same graceful-degradation principle as an absent Qwen/Vision key.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Telegram bot username only — the bot itself (token, actual sending/receiving) lives in the
# standalone telegram-bot/ service (see telegram-bot/.env.example), not here. This backend only
# needs the username to build deep-link URLs (https://t.me/{username}?start=...).
TELEGRAM_BOT_USERNAME=academix_notify_bot

# SeaweedFS S3-compatible storage — must match infra/seaweedfs-config/s3-config.json's identity
# (plain seaweedfs -s3 with no -s3.config rejects every signed request outright, see CLAUDE.md).
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=local-dev-access-key
SEAWEEDFS_SECRET_KEY=local-dev-secret-key

# ClamAV upload scanning (academix_tz.md §5.2). Off by default because the clamav container is
# ~1GB and needs several minutes to load signature databases before it accepts connections.
# PRODUCTION MUST SET THIS TO true — while it's false the backend logs a startup WARN and stores
# uploads unscanned. Start the daemon with:
#   docker-compose -f infra/docker-compose.yml --profile antivirus up -d clamav
# When enabled, uploads FAIL CLOSED if clamd is unreachable (a deliberately different choice from
# the AI pipeline's graceful degradation — an unscanned upload is a permanent hole, not a delay).
ACADEMIX_CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
