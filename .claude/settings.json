{
  "//": "Hook commands are prefixed with $CLAUDE_PROJECT_DIR (set by Claude Code to the project root) because a bare relative path only resolves when the session's working directory happens to BE the repo root. Working from frontend/ or backend/ instead, `bash .claude/hooks/...` silently fails to launch and every hook here becomes a no-op. The `:-.` fallback preserves the old behavior if the variable is ever absent. The scripts themselves also resolve the repo root from their own location, so both halves are CWD-independent.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/shared/spec-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/shared/secrets-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/backend/destructive-migration-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/frontend/i18n-scope-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/backend/new-tenant-table-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/backend/role-leak-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/backend/build-gate.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/frontend/lint-gate.sh\""
          }
        ]
      }
    ]
  }
}
